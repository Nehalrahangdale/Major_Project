<% layout("/layouts/boilerplates") %>

<body>
    <h3>Create new: </h3>
    <div class="row mt-3">
        <div class="col-8 offset-2">
    <form method="post" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="mb-2">
            <label for="title" class="form-label">Title</label>
            <input type="text" placeholder="Enter title" name="listing[title]"
            class="form-control" required>
            <div class="valid-feedback">Look good Title!</div>
        </div>
        <div class="mb-2">
        <label for="description" class="form-label">Description</label>
   
        <textarea  type="text" placeholder="Enter the description" name="listing[description]"
        class="form-control" required></textarea>
         <div class="invalid-feedback">Plase enter short description</div>

        </div>
        <!-- <div class="mb-2">
         <label for="image" class="form-label">image-link</label>
          <input type="text" placeholder="Enter Url link" name="listing[image]"
        class="form-control" >
        </div> -->
        <div class="mb-2">
         <label for="image" class="form-label">Upload image</label>
          <input type="file" name="listing[image]"
        class="form-control" required >
        </div>
       <div class="row">
       <div class="mb-2 col-md-4">
         <label for="price" class="form-label">Price</label>
         <input placeholder="Enter price" name="listing[price]" class="form-control" required>
        </div>
        <div class="mb-2 col-md-8">
         <label for="country" class="form-label">Country</label>
   
         <input type="text" placeholder="Enter country" name="listing[country]" class="form-control"required>
        <div class="invalid-feedback">Plase enter Correct Country</div>

        </div>
        </div>
        <div class="mb-2">
        <label for="location" class="form-label">Location</label>

        <input type="text" placeholder="Enter location" name="listing[location]" class="form-control" required>
        <div class="invalid-feedback">Plase enter Correct Location</div>

    </div>
    
        <button class="btn btn-dark add-btn mt-3">Add</button>
    </form>
    </div>
    </div>
</body>
